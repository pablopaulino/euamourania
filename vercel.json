{
  "crons": [
    {
      "path": "/api/melhores-votar?cron=limpeza",
      "schedule": "17 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/melhores-de-urania/:path*",
      "has": [
        { "type": "host", "value": "melhores.euamourania.com.br" }
      ],
      "destination": "https://euamourania.com.br/melhores-de-urania/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "melhores.euamourania.com.br" }
      ],
      "destination": "https://euamourania.com.br/melhores-de-urania/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "melhores.euamourania.com.br" }
      ],
      "destination": "https://euamourania.com.br/melhores-de-urania/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/urania.html", "destination": "/urania/", "permanent": true },
    { "source": "/links/", "destination": "/links", "permanent": true },
    {
      "source": "/news-detalhes.html",
      "has": [
        { "type": "query", "key": "slug", "value": "(?<slug>[a-z0-9-]+)" }
      ],
      "destination": "/noticias/:slug",
      "permanent": true
    },
    {
      "source": "/news-details.html",
      "has": [
        { "type": "query", "key": "slug", "value": "(?<slug>[a-z0-9-]+)" }
      ],
      "destination": "/noticias/:slug",
      "permanent": true
    },
    { "source": "/news-detalhes.html", "destination": "/news/", "permanent": true },
    { "source": "/news-details.html", "destination": "/news/", "permanent": true },
    {
      "source": "/turismo-details.html",
      "has": [
        { "type": "query", "key": "slug", "value": "(?<slug>[a-z0-9-]+)" }
      ],
      "destination": "/turismo/:slug",
      "permanent": true
    },
    {
      "source": "/eventos/detalhes.html",
      "has": [
        { "type": "query", "key": "slug", "value": "(?<slug>[a-z0-9-]+)" }
      ],
      "destination": "/eventos/agenda/:slug",
      "permanent": true
    },
    { "source": "/turismo-details.html", "destination": "/turismo.html", "permanent": true },
    { "source": "/app.html", "destination": "/app", "permanent": true },
    { "source": "/app/", "destination": "/app", "permanent": true },
    { "source": "/app/parceiros.html", "destination": "/app/parceiros", "permanent": true },
    { "source": "/app/parceiros/", "destination": "/app/parceiros", "permanent": true },
    { "source": "/pt/parceiros", "destination": "/app/parceiros", "permanent": true },
    { "source": "/pt/parceiros/", "destination": "/app/parceiros", "permanent": true },
    { "source": "/pt/parceiros.html", "destination": "/app/parceiros", "permanent": true },
    { "source": "/divulgue.html", "destination": "/divulgue", "permanent": true },
    { "source": "/divulgue/", "destination": "/divulgue", "permanent": true },
    { "source": "/categorias/:categoria", "destination": "/news/:categoria", "permanent": true },
    { "source": "/categorias/:categoria/", "destination": "/news/:categoria", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/home" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/noticias", "destination": "/admin/index.html" },
    { "source": "/admin/aprovacoes", "destination": "/admin/index.html" },
    { "source": "/admin/colaboracoes", "destination": "/admin/index.html" },
    { "source": "/admin/guia", "destination": "/admin/index.html" },
    { "source": "/admin/guia-comercial", "destination": "/admin/index.html" },
    { "source": "/admin/guia-verificacao", "destination": "/admin/index.html" },
    { "source": "/admin/turismo", "destination": "/admin/index.html" },
    { "source": "/admin/turismo-verificacao", "destination": "/admin/index.html" },
    { "source": "/admin/telefones-uteis", "destination": "/admin/index.html" },
    { "source": "/admin/iniciativas", "destination": "/admin/index.html" },
    { "source": "/admin/links", "destination": "/admin/index.html" },
    { "source": "/admin/agenda", "destination": "/admin/index.html" },
    { "source": "/admin/eventos", "destination": "/admin/index.html" },
    { "source": "/admin/eventos-principais", "destination": "/admin/index.html" },
    { "source": "/admin/edicoes", "destination": "/admin/index.html" },
    { "source": "/admin/categorias", "destination": "/admin/index.html" },
    { "source": "/admin/audiencia", "destination": "/admin/index.html" },
    { "source": "/admin/configuracoes", "destination": "/admin/index.html" },
    { "source": "/admin/midia", "destination": "/admin/index.html" },
    { "source": "/admin/banners", "destination": "/admin/index.html" },
    { "source": "/admin/publicidade", "destination": "/admin/index.html" },
    { "source": "/admin/comunicacao", "destination": "/admin/index.html" },
    { "source": "/admin/viva-urania", "destination": "/admin/index.html" },
    { "source": "/admin/notificacoes", "destination": "/admin/index.html" },
    { "source": "/admin/melhores", "destination": "/admin/index.html" },
    { "source": "/admin/submissoes", "destination": "/admin/index.html" },
    { "source": "/admin/usuarios", "destination": "/admin/index.html" },
    { "source": "/admin/importacao", "destination": "/admin/index.html" },
    { "source": "/melhores-de-urania/categorias/:categoria", "destination": "/melhores-de-urania/categoria-permanente.html?categoria=:categoria" },
    { "source": "/melhores-de-urania/categorias/:categoria/", "destination": "/melhores-de-urania/categoria-permanente.html?categoria=:categoria" },
    { "source": "/melhores-de-urania/:ano/votacao", "destination": "/melhores-de-urania/votacao.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/votacao/", "destination": "/melhores-de-urania/votacao.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/votacao/:categoria", "destination": "/melhores-de-urania/votacao.html?ano=:ano&categoria=:categoria" },
    { "source": "/melhores-de-urania/:ano/votacao/:categoria/", "destination": "/melhores-de-urania/votacao.html?ano=:ano&categoria=:categoria" },
    { "source": "/melhores-de-urania/:ano/regulamento", "destination": "/melhores-de-urania/regulamento.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/regulamento/", "destination": "/melhores-de-urania/regulamento.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/metodologia", "destination": "/melhores-de-urania/metodologia.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/metodologia/", "destination": "/melhores-de-urania/metodologia.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/categorias/:categoria", "destination": "/melhores-de-urania/categoria.html?ano=:ano&categoria=:categoria" },
    { "source": "/melhores-de-urania/:ano/categorias/:categoria/", "destination": "/melhores-de-urania/categoria.html?ano=:ano&categoria=:categoria" },
    { "source": "/melhores-de-urania/:ano/resultados", "destination": "/melhores-de-urania/resultados.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/resultados/", "destination": "/melhores-de-urania/resultados.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano", "destination": "/melhores-de-urania/edicao.html?ano=:ano" },
    { "source": "/melhores-de-urania/:ano/", "destination": "/melhores-de-urania/edicao.html?ano=:ano" },
    { "source": "/eventos/agenda/:slug", "destination": "/eventos/detalhes.html?slug=:slug" },
    { "source": "/eventos/agenda/:slug/", "destination": "/eventos/detalhes.html?slug=:slug" },
    { "source": "/eventos/:slug/:ano", "destination": "/eventos/edicao.html?slug=:slug&ano=:ano" },
    { "source": "/eventos/:slug/:ano/", "destination": "/eventos/edicao.html?slug=:slug&ano=:ano" },
    { "source": "/eventos/:slug", "destination": "/eventos/evento.html?slug=:slug" },
    { "source": "/eventos/:slug/", "destination": "/eventos/evento.html?slug=:slug" },
    { "source": "/links", "destination": "/links/index.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/parceiros", "destination": "/app/parceiros.html" },
    { "source": "/divulgue", "destination": "/divulgue.html" },
    { "source": "/api/newsletter-open", "destination": "/api/newsletter-track?event=open" },
    { "source": "/api/newsletter-click", "destination": "/api/newsletter-track?event=click" },
    { "source": "/noticias/feed.xml", "destination": "/api/rss" },
    {
      "source": "/news/:categoria((?!sobre-publicacoes$|politica-editorial$|correcoes-transparencia-contato$|feed\\.xml$)[a-z0-9-]+)",
      "destination": "/categorias/index.html?categoria=:categoria"
    },
    {
      "source": "/news/:categoria((?!sobre-publicacoes$|politica-editorial$|correcoes-transparencia-contato$|feed\\.xml$)[a-z0-9-]+)/",
      "destination": "/categorias/index.html?categoria=:categoria"
    },
    { "source": "/noticias/:slug", "destination": "/api/noticia?slug=:slug" },
    { "source": "/guia/categoria/:slug", "destination": "/api/noticia?tipo=guia-categoria&slug=:slug" },
    { "source": "/guia/categoria/:slug/", "destination": "/api/noticia?tipo=guia-categoria&slug=:slug" },
    { "source": "/guia/:slug", "destination": "/api/noticia?tipo=guia&slug=:slug" },
    { "source": "/turismo/:slug", "destination": "/api/noticia?tipo=turismo&slug=:slug" },
    { "source": "/turismo/:slug/", "destination": "/api/noticia?tipo=turismo&slug=:slug" },
    { "source": "/iniciativas/:slug", "destination": "/api/iniciativa?slug=:slug" },
    { "source": "/iniciativas/:slug/", "destination": "/api/iniciativa?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemaps?type=standard" },
    { "source": "/news-sitemap.xml", "destination": "/api/sitemaps?type=news" },
    { "source": "/rss.xml", "destination": "/api/rss" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|favicon.png|apple-touch-icon.png|manifest.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
